// use prisma-next

model Company {
  id        String              @id @default(uuid())
  name      String
  industry  String?
  website   String?
  phone     String?
  email     String?
  address   String?
  city      String?
  state     String?
  source    String?
  status    String              @default("Prospect")

  contacts    Contact[]
  leads       Lead[]
  activities  Activity[]
  quotations  Quotation[]
  samples     Sample[]
  reports     Report[]

  createdAt TimestamptzString   @default(now())
  updatedAt temporal.updatedAtString()
}

model Contact {
  id            String              @id @default(uuid())
  companyId     String
  company       Company             @relation(fields: [companyId], references: [id])

  name          String
  designation   String?
  phone         String?
  email         String?
  linkedin      String?
  decisionMaker Boolean             @default(false)

  createdAt     TimestamptzString   @default(now())
  updatedAt     temporal.updatedAtString()
}

model Lead {
  id            String              @id @default(uuid())

  companyId     String?
  companyRecord Company?            @relation(fields: [companyId], references: [id])

  name          String
  company       String
  phone         String
  email         String
  service       String
  requirement   String
  source        String              @default("Nexus Hyderabad Website")
  status        String              @default("New Lead")
  notes         String?
  nextFollowUp  TimestamptzString?

  createdAt     TimestamptzString   @default(now())
  updatedAt     temporal.updatedAtString()
}

model Activity {
  id            String              @id @default(uuid())

  companyId     String
  company       Company             @relation(fields: [companyId], references: [id])

  type          String
  title         String
  description   String?
  outcome       String?
  activityDate  TimestamptzString
  nextAction    String?
  nextFollowUp  TimestamptzString?

  createdAt     TimestamptzString   @default(now())
  updatedAt     temporal.updatedAtString()
}

model Quotation {
  id              String              @id @default(uuid())

  companyId       String
  company         Company             @relation(fields: [companyId], references: [id])

  quotationNumber String
  service         String
  description     String?

  amount          Float
  gstPercent      Float               @default(18)
  gstAmount       Float
  totalAmount     Float

  status          String              @default("Draft")
  quotationDate   TimestamptzString
  sentDate        TimestamptzString?
  nextFollowUp    TimestamptzString?

  notes           String?

  samples         Sample[]

  createdAt       TimestamptzString   @default(now())
  updatedAt       temporal.updatedAtString()
}

model Sample {
  id                     String              @id @default(uuid())

  companyId              String
  company                Company             @relation(fields: [companyId], references: [id])

  quotationId            String?
  quotation              Quotation?          @relation(fields: [quotationId], references: [id])

  sampleNumber           String
  sampleType             String
  sampleCount            Int                 @default(1)

  collectionDate         TimestamptzString?
  collectedBy            String?

  status                 String              @default("Planned")

  testingLocation        String?
  expectedCompletionDate TimestamptzString?

  reportStatus           String              @default("Pending")
  reportDeliveredDate    TimestamptzString?

  notes                  String?

  reports                Report[]

  createdAt              TimestamptzString   @default(now())
  updatedAt              temporal.updatedAtString()
}

model Report {
  id              String              @id @default(uuid())

  companyId       String
  company         Company             @relation(fields: [companyId], references: [id])

  sampleId        String
  sample          Sample              @relation(fields: [sampleId], references: [id])

  reportNumber    String
  reportType      String              @default("Final Report")

  reportDate      TimestamptzString?

  status          String              @default("Pending")

  deliveredDate   TimestamptzString?
  deliveryMethod  String?

  fileReference   String?

  notes           String?

  createdAt       TimestamptzString   @default(now())
  updatedAt       temporal.updatedAtString()
}