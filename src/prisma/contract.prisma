// use prisma-next

model Company {
  id String @id @default(uuid())
  name String
  industry String?
  website String?
  phone String?
  email String?
  address String?
  city String?
  state String?
  source String?
  status String @default("Prospect")
  contacts Contact[]
  leads Lead[]
  activities Activity[]
  quotations Quotation[]
  samples Sample[]
  reports Report[]
  locations Location[]
  workOrders WorkOrder[]
  payments Payment[]
  recurringServices RecurringService[]
  planItems PlanItem[]
  marketingProspects MarketingProspect[]
  documents Document[]
  createdAt TimestamptzString @default(now())
  updatedAt temporal.updatedAtString()
}
model Contact { id String @id @default(uuid()) companyId String company Company @relation(fields:[companyId],references:[id]) name String designation String? phone String? email String? linkedin String? decisionMaker Boolean @default(false) createdAt TimestamptzString @default(now()) updatedAt temporal.updatedAtString() }
model Lead {
  id String @id @default(uuid())
  companyId String?
  companyRecord Company? @relation(fields:[companyId],references:[id])
  name String
  company String
  phone String
  email String
  service String
  requirement String
  source String @default("Nexus Hyderabad Website")
  salesOwner String?
  status String @default("New Lead")
  isRead Boolean @default(false)
  notes String?
  nextFollowUp TimestamptzString?
  marketingProspect MarketingProspect?
  createdAt TimestamptzString @default(now())
  updatedAt temporal.updatedAtString()
}
model Activity { id String @id @default(uuid()) companyId String company Company @relation(fields:[companyId],references:[id]) type String title String description String? outcome String? activityDate TimestamptzString nextAction String? nextFollowUp TimestamptzString? createdAt TimestamptzString @default(now()) updatedAt temporal.updatedAtString() }
model Quotation {
 id String @id @default(uuid()) companyId String company Company @relation(fields:[companyId],references:[id]) quotationNumber String service String description String? amount Float gstPercent Float @default(18) gstAmount Float totalAmount Float salesOwner String? status String @default("Draft") quotationDate TimestamptzString sentDate TimestamptzString? nextFollowUp TimestamptzString? notes String? items QuotationItem[] samples Sample[] workOrders WorkOrder[] payments Payment[] documents Document[] createdAt TimestamptzString @default(now()) updatedAt temporal.updatedAtString()
}
model Sample { id String @id @default(uuid()) companyId String company Company @relation(fields:[companyId],references:[id]) locationId String? location Location? @relation(fields:[locationId],references:[id]) quotationId String? quotation Quotation? @relation(fields:[quotationId],references:[id]) workOrderId String? workOrder WorkOrder? @relation(fields:[workOrderId],references:[id]) sampleNumber String sampleType String sampleCount Int @default(1) collectionDate TimestamptzString? collectionMonth String? collectedBy String? status String @default("Planned") testingLocation String? expectedCompletionDate TimestamptzString? reportStatus String @default("Pending") reportDeliveredDate TimestamptzString? notes String? reports Report[] documents Document[] createdAt TimestamptzString @default(now()) updatedAt temporal.updatedAtString() }
model Report { id String @id @default(uuid()) companyId String company Company @relation(fields:[companyId],references:[id]) sampleId String sample Sample @relation(fields:[sampleId],references:[id]) reportNumber String reportType String @default("Final Report") reportDate TimestamptzString? status String @default("Pending") deliveredDate TimestamptzString? deliveryMethod String? fileReference String? notes String? documents Document[] createdAt TimestamptzString @default(now()) updatedAt temporal.updatedAtString() }
model Location { id String @id @default(uuid()) companyId String company Company @relation(fields:[companyId],references:[id]) name String address String? city String? state String? contactName String? phone String? email String? status String @default("Active") notes String? recurringServices RecurringService[] samples Sample[] createdAt TimestamptzString @default(now()) updatedAt temporal.updatedAtString() }
model QuotationItem { id String @id @default(uuid()) quotationId String quotation Quotation @relation(fields:[quotationId],references:[id]) service String description String? quantity Int @default(1) unitPrice Float @default(0) amount Float @default(0) createdAt TimestamptzString @default(now()) updatedAt temporal.updatedAtString() }
model WorkOrder {
 id String @id @default(uuid()) companyId String company Company @relation(fields:[companyId],references:[id]) quotationId String? quotation Quotation? @relation(fields:[quotationId],references:[id]) workOrderNumber String service String description String? amount Float gstPercent Float @default(18) gstAmount Float totalAmount Float salesOwner String? status String @default("Confirmed") confirmedDate TimestamptzString expectedStart TimestamptzString? expectedEnd TimestamptzString? notes String? samples Sample[] payments Payment[] documents Document[] createdAt TimestamptzString @default(now()) updatedAt temporal.updatedAtString()
}
model Payment { id String @id @default(uuid()) companyId String company Company @relation(fields:[companyId],references:[id]) quotationId String? quotation Quotation? @relation(fields:[quotationId],references:[id]) workOrderId String? workOrder WorkOrder? @relation(fields:[workOrderId],references:[id]) amount Float paymentDate TimestamptzString paymentMethod String? reference String? status String @default("Received") notes String? documents Document[] createdAt TimestamptzString @default(now()) updatedAt temporal.updatedAtString() }
model RecurringService { id String @id @default(uuid()) companyId String company Company @relation(fields:[companyId],references:[id]) locationId String? location Location? @relation(fields:[locationId],references:[id]) service String sampleType String samplesPerMonth Int @default(1) frequency String @default("Monthly") status String @default("Active") startDate TimestamptzString? endDate TimestamptzString? notes String? createdAt TimestamptzString @default(now()) updatedAt temporal.updatedAtString() }
model PlanItem { id String @id @default(uuid()) companyId String? company Company? @relation(fields:[companyId],references:[id]) title String description String? category String @default("Operations") priority String @default("Medium") status String @default("Planned") dueDate TimestamptzString? completedAt TimestamptzString? notes String? createdAt TimestamptzString @default(now()) updatedAt temporal.updatedAtString() }
model MarketingProspect { id String @id @default(uuid()) companyId String? company Company? @relation(fields:[companyId],references:[id]) leadId String? @unique lead Lead? @relation(fields:[leadId],references:[id]) companyName String contactName String? designation String? linkedin String? email String? phone String? industry String? source String @default("LinkedIn") targetService String? outreachStatus String @default("Identified") priority String @default("Medium") lastContacted TimestamptzString? nextFollowUp TimestamptzString? converted Boolean @default(false) convertedDate TimestamptzString? notes String? createdAt TimestamptzString @default(now()) updatedAt temporal.updatedAtString() }
model Document { id String @id @default(uuid()) companyId String? company Company? @relation(fields:[companyId],references:[id]) quotationId String? quotation Quotation? @relation(fields:[quotationId],references:[id]) workOrderId String? workOrder WorkOrder? @relation(fields:[workOrderId],references:[id]) sampleId String? sample Sample? @relation(fields:[sampleId],references:[id]) reportId String? report Report? @relation(fields:[reportId],references:[id]) paymentId String? payment Payment? @relation(fields:[paymentId],references:[id]) title String documentType String documentNumber String? description String? fileName String? fileUrl String? fileReference String? mimeType String? fileSize Int? status String @default("Active") issueDate TimestamptzString? expiryDate TimestamptzString? notes String? createdAt TimestamptzString @default(now()) updatedAt temporal.updatedAtString() }
model Notification { id String @id @default(uuid()) type String title String message String? entityType String? entityId String? actionUrl String? isRead Boolean @default(false) createdAt TimestamptzString @default(now()) updatedAt temporal.updatedAtString() }
